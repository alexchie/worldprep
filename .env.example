# ===== 基本 =====
TIMEZONE=Asia/Taipei
DATABASE_URL=sqlite:///./data/worldprep.db
STORAGE_BACKEND=local
STORAGE_ROOT=./storage
LOG_DIR=./logs
TARGET_VIDEO_LENGTH_MINUTES=12
NARRATION_CHARS_PER_MINUTE=260

# ===== Claude (研究 / 查核 / 腳本 / 分鏡 / 標題) =====
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# 研究與腳本以外的 agent（選題、查核、分鏡、標題、說明、縮圖、QA）
LLM_FAST_MODEL=claude-haiku-4-5
LLM_EFFORT=high

# ===== 語音: azure | edge | mock =====
VOICE_PROVIDER=edge
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastasia
VOICE_NAME=zh-TW-HsiaoChenNeural

# ===== 視覺 =====
# 授權素材 (https://www.pexels.com/api/)
PEXELS_API_KEY=
# Pixabay 照片與影片 (https://pixabay.com/api/docs/)
PIXABAY_API_KEY=
# AI 圖像: openai | none
IMAGE_PROVIDER=none
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# ===== 配樂 (放入 music/ 並在 music/library.json 記錄授權) =====
MUSIC_DIR=./music

# ===== Email (SMTP；Gmail 需 App Password) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# ===== 成本 =====
DAILY_BUDGET_USD=15
EPISODE_BUDGET_USD=12

# ===== 排程 (Asia/Taipei, HH:MM) =====
SCHEDULE_PRODUCE=18:00
SCHEDULE_EMAIL=08:00

# ===== 字型 / FFmpeg (留空自動偵測) =====
FONT_BOLD=
FONT_REGULAR=
FFMPEG_PATH=

# ===== Google Drive（成品交付與狀態同步）=====
GOOGLE_CLIENT_SECRETS=./secrets/client_secret.json
GOOGLE_TOKEN_FILE=./secrets/google_token.json
# 指定的資料夾 ID（網址 drive.google.com/drive/folders/<這段>）
DRIVE_FOLDER_ID=

# ===== 選題 =====
# 回覆 08:00 通知信即可指定下一集主題；沒有指定時：auto=從選題池自動選題，skip=當天不製作
TOPIC_FALLBACK=skip
